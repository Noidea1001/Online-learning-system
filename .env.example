# ============================================================
# .env.example — Copy this to .env and fill in your values.
# This file IS safe to commit to git (no real secrets here).
# ============================================================

DEBUG=True
SECRET_KEY=replace-with-a-strong-random-key

# Neon PostgreSQL (leave blank to use SQLite3 locally)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Cloudinary (leave blank to use local /media/ folder)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: add your custom domain for CSRF protection
# CSRF_TRUSTED_ORIGIN=https://your-custom-domain.com
